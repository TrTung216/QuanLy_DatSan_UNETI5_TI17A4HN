@* M1: Trần Trọng Tùng; MSSV: 23103100202. Codex hỗ trợ chi tiết loại sân và số sân liên quan. *@
@model QuanLyDatSan_UNETI5_DHTI17A4HN.ViewModels.LoaiSan.LoaiSanChiTietViewModel
@using QuanLyDatSan_UNETI5_DHTI17A4HN.Enums
@using System.Globalization
@using QuanLyDatSan_UNETI5_DHTI17A4HN.Services.Anh
@using QuanLyDatSan_UNETI5_DHTI17A4HN.ViewModels.Chung.Anh
@{
    ViewData["Title"] = "Chi tiết loại sân";
    var hoatDong = Model.TrangThai == TrangThaiLoaiSan.HoatDong;
    var lopTrangThai = "ql-status--cancelled";
    var tenTrangThai = "Ngừng hoạt động";
    if (hoatDong)
    {
        lopTrangThai = "ql-status--completed";
        tenTrangThai = "Hoạt động";
    }
}
<div class="ql-page-header"><h1>@Model.TenLoai</h1><p class="ql-subtitle">Thông tin danh mục loại sân.</p></div>
<section class="ql-panel ql-details" aria-label="Chi tiết loại sân">
    <dl class="row">
        <dt class="col-sm-4">Tên loại sân</dt><dd class="col-sm-8">@Model.TenLoai</dd>
        <dt class="col-sm-4">Mô tả</dt><dd class="col-sm-8 text-break" style="white-space: pre-line">@(Model.MoTa ?? "Chưa có mô tả")</dd>
        <dt class="col-sm-4">Số người tối đa</dt><dd class="col-sm-8">@Model.SoNguoiToiDa</dd>
        <dt class="col-sm-4">Đơn giá mặc định</dt><dd class="col-sm-8">@Model.DonGiaTheoGio.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫/giờ</dd>
        <dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8"><span class="ql-status @lopTrangThai">@tenTrangThai</span></dd>
        <dt class="col-sm-4">Số sân đang tham chiếu</dt><dd class="col-sm-8">@Model.SoSan</dd>
    </dl>
    <p class="text-muted">Cập nhật giá loại sân không thay đổi giá sân hoặc giao dịch đã phát sinh.</p>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-action="Sua" asp-route-id="@Model.MaLoaiSan">Cập nhật / đổi trạng thái</a>
        <a class="btn btn-outline-danger" asp-action="Xoa" asp-route-id="@Model.MaLoaiSan">Kiểm tra xóa</a>
        <a class="btn btn-outline-secondary" asp-action="DanhSach">Về danh sách</a>
    </div>
</section>
<section class="ql-panel mt-4" aria-labelledby="anh-minh-hoa">
    <h2 id="anh-minh-hoa" class="h4">Ảnh minh họa loại sân</h2>
    <partial name="_AnhDaiDien" model="@(new AnhDaiDienViewModel(NhomAnh.LoaiSan, Model.MaLoaiSan, Model.TenLoai, Model.DuongDanAnh is not null, ChiTiet: true, TaiCham: false))" />
    <form asp-action="CapNhatAnh" asp-route-id="@Model.MaLoaiSan" method="post" enctype="multipart/form-data" asp-antiforgery="true">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <input type="hidden" name="AnhCu" value="@Model.DuongDanAnh" />
        <div class="mb-3">
            <label for="tep-anh" class="form-label">Chọn ảnh minh họa mới</label>
            <input id="tep-anh" name="Tep" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" aria-describedby="quy-tac-anh" />
            <p id="quy-tac-anh" class="form-text">JPEG, PNG hoặc WebP tĩnh; tối đa 5 MiB, 4096 px mỗi chiều và 16 triệu điểm ảnh. Ảnh được chuyển sang JPEG, xóa metadata. Khi gỡ ảnh, để trống ô chọn tệp.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" name="ThaoTac" value="ThayAnh" type="submit">Lưu ảnh</button>
            @if (Model.DuongDanAnh is not null)
            { <button class="btn btn-outline-danger" name="ThaoTac" value="GoAnh" type="submit">Gỡ ảnh</button> }
        </div>
    </form>
</section>
