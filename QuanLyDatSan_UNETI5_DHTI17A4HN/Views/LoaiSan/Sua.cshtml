@* M1: Trần Trọng Tùng; MSSV: 23103100202. Codex hỗ trợ cập nhật thông tin và trạng thái loại sân. *@
@model QuanLyDatSan_UNETI5_DHTI17A4HN.ViewModels.LoaiSan.LoaiSanFormViewModel
@using QuanLyDatSan_UNETI5_DHTI17A4HN.Services.Anh
@using QuanLyDatSan_UNETI5_DHTI17A4HN.ViewModels.Chung.Anh
@{ ViewData["Title"] = "Cập nhật loại sân"; }
<div class="ql-page-header"><h1>@ViewData["Title"]</h1><p class="ql-subtitle">Các trường có dấu * là bắt buộc.</p></div>
<div class="row"><div class="col-xl-8">
    <section class="ql-panel" aria-label="Cập nhật loại sân">
        <form asp-action="Sua" asp-route-id="@ViewData["MaLoaiSan"]" method="post" asp-antiforgery="true" data-loai-san-form>
            <partial name="_Form" model="Model" />
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-action="ChiTiet" asp-route-id="@ViewData["MaLoaiSan"]" class="btn btn-outline-secondary">Hủy</a>
        </form>
    </section>

    <section class="ql-panel mt-4" aria-labelledby="anh-minh-hoa">
        <h2 id="anh-minh-hoa" class="h4">Ảnh minh họa loại sân</h2>
        <partial name="_AnhDaiDien" model="@(new AnhDaiDienViewModel(NhomAnh.LoaiSan, (int)ViewData["MaLoaiSan"]!, Model.TenLoai, Model.DuongDanAnh is not null, ChiTiet: true, TaiCham: false))" />
        <form asp-action="CapNhatAnh" asp-route-id="@ViewData["MaLoaiSan"]" method="post" enctype="multipart/form-data" asp-antiforgery="true">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <input type="hidden" name="AnhCu" value="@Model.DuongDanAnh" />
            <div class="mb-3">
                <label for="tep-anh" class="form-label">Chọn ảnh minh họa mới</label>
                <input id="tep-anh" name="Tep" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" aria-describedby="quy-tac-anh" />
                <p id="quy-tac-anh" class="form-text">JPEG, PNG hoặc WebP tĩnh; tối đa 5 MiB, 4096 px mỗi chiều và 16 triệu điểm ảnh. Ảnh được chuyển sang JPEG, xóa metadata. Khi gỡ ảnh, để trống ô chọn tệp.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-primary" name="ThaoTac" value="ThayAnh" type="submit">Lưu ảnh</button>
                @if (Model.DuongDanAnh is not null)
                { <button class="btn btn-outline-danger" name="ThaoTac" value="GoAnh" type="submit">Gỡ ảnh</button> }
            </div>
        </form>
    </section>
</div></div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/loai-san.js" asp-append-version="true"></script>
}
