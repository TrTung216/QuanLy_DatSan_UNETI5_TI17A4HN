@* M3: Nguyễn Văn Quý; MSSV: 23103100181. giao diện sửa hồ sơ cá nhân của khách hàng. *@
@model QuanLyDatSan_UNETI5_DHTI17A4HN.ViewModels.HoSoViewModel
@{ ViewData["Title"] = "Chỉnh sửa hồ sơ"; }
<div class="ql-form-page">
    <div class="ql-page-header">
        <p class="ql-eyebrow">Khách hàng</p>
        <h1>Chỉnh sửa hồ sơ</h1>
        <p class="ql-subtitle">Tên đăng nhập: @Model.TenDangNhap. Các trường có dấu * là bắt buộc.</p>
    </div>
    <section class="ql-panel" aria-label="Biểu mẫu chỉnh sửa hồ sơ">
        <form asp-action="Sua" method="post" id="sua-ho-so">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <partial name="_TruongThongTinKhach" model="Model" />
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="Index" class="btn btn-link">Hủy</a>
        </form>
    </section>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('sua-ho-so').addEventListener('submit', function () {
            if ($(this).valid()) this.querySelector('button[type="submit"]').disabled = true;
        });
    </script>
}
