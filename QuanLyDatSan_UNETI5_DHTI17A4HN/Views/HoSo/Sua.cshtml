@model QuanLyDatSan_UNETI5_DHTI17A4HN.ViewModels.HoSoViewModel
@{ ViewData["Title"] = "Chỉnh sửa hồ sơ"; }
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-3">Chỉnh sửa hồ sơ</h1>
        <p class="text-muted">Tên đăng nhập: @Model.TenDangNhap</p>
        <form asp-action="Sua" method="post" id="sua-ho-so">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <partial name="_TruongThongTinKhach" model="Model" />
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="Index" class="btn btn-link">Hủy</a>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('sua-ho-so').addEventListener('submit', function () {
            if ($(this).valid()) this.querySelector('button[type="submit"]').disabled = true;
        });
    </script>
}
