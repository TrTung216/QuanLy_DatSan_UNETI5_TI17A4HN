@* Họ tên: Phan Giang Tâm; MSSV: 23103100196. Nội dung: Trang danh sách sân. *@
@model QuanLyDatSan_UNETI5_DHTI17A4HN.ViewModels.DanhSachSanViewModel
@using QuanLyDatSan_UNETI5_DHTI17A4HN.Enums
@using System.Globalization
@{
    ViewData["Title"] = "Danh sách sân";
    var vanHoa = CultureInfo.GetCultureInfo("vi-VN");
    var laQuanLy = User.Identity?.IsAuthenticated == true && (User.IsInRole(nameof(VaiTro.Admin)) || User.IsInRole(nameof(VaiTro.NhanVien)));
    var coDieuKien = !string.IsNullOrWhiteSpace(Model.TuKhoa) || Model.MaLoaiSan.HasValue
        || Model.TrangThai.HasValue || Model.GiaTu.HasValue || Model.GiaDen.HasValue
        || Model.NgaySuDung.HasValue || Model.GioBatDau.HasValue || Model.GioKetThuc.HasValue;
    // Giữ mọi điều kiện ở các liên kết phân trang; tiền dùng định dạng URL không có dấu phân cách.
    var thamSoTrang = new Dictionary<string, string>
    {
        ["tuKhoa"] = Model.TuKhoa ?? "",
        ["maLoaiSan"] = Model.MaLoaiSan?.ToString(CultureInfo.InvariantCulture) ?? "",
        ["trangThai"] = Model.TrangThai.HasValue ? ((int)Model.TrangThai.Value).ToString(CultureInfo.InvariantCulture) : "",
        ["giaTu"] = Model.GiaTu?.ToString("0", CultureInfo.InvariantCulture) ?? "",
        ["giaDen"] = Model.GiaDen?.ToString("0", CultureInfo.InvariantCulture) ?? "",
        ["sapXep"] = Model.SapXep,
        ["ngaySuDung"] = Model.NgaySuDung?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "",
        ["gioBatDau"] = Model.GioBatDau?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? "",
        ["gioKetThuc"] = Model.GioKetThuc?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? ""
    };
}
<div class="ql-page-header">
    <h1>Danh sách sân</h1>
    <p class="ql-subtitle">Xem thông tin, giá thuê và giờ phục vụ của các sân thể thao.</p>
</div>
<section class="ql-panel" aria-label="Danh sách sân thể thao">
    <form asp-action="Index" method="get" class="row g-3 mb-4" aria-label="Tìm và lọc sân">
        <div asp-validation-summary="All" class="text-danger col-12" role="alert"></div>
        <div class="col-md-4">
            <label asp-for="NgaySuDung" class="form-label"></label>
            <input asp-for="NgaySuDung" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" aria-describedby="tra-cuu-gio" />
            <span asp-validation-for="NgaySuDung" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="GioBatDau" class="form-label"></label>
            <input asp-for="GioBatDau" type="time" asp-format="{0:HH:mm}" step="60" class="form-control" />
            <span asp-validation-for="GioBatDau" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="GioKetThuc" class="form-label"></label>
            <input asp-for="GioKetThuc" type="time" asp-format="{0:HH:mm}" step="60" class="form-control" />
            <span asp-validation-for="GioKetThuc" class="text-danger"></span>
        </div>
        <p id="tra-cuu-gio" class="form-text col-12 mb-0">Nhập đủ ngày và giờ để tìm sân trống. Để trống cả ba ô để xem danh sách thông thường. Kết quả tìm kiếm không giữ chỗ; lịch sẽ được kiểm tra lại khi đặt sân.</p>
        <div class="col-md-6 col-lg-4">
            <label asp-for="TuKhoa" class="form-label"></label>
            <input asp-for="TuKhoa" class="form-control" maxlength="100" placeholder="Tên sân, tên loại sân hoặc địa chỉ" />
        </div>
        <div class="col-md-6 col-lg-4">
            <label asp-for="MaLoaiSan" class="form-label"></label>
            <select asp-for="MaLoaiSan" class="form-select">
                <option value="">Tất cả loại sân</option>
                @foreach (var loai in Model.CacLoaiSan)
                {
                    <option value="@loai.MaLoaiSan">@loai.TenLoai</option>
                }
            </select>
        </div>
        @if (laQuanLy)
        {
            <div class="col-md-6 col-lg-4">
                <label asp-for="TrangThai" class="form-label"></label>
                <select asp-for="TrangThai" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    <option value="1">Hoạt động</option>
                    <option value="2">Bảo trì</option>
                    <option value="3">Ngừng hoạt động</option>
                </select>
            </div>
        }
        <div class="col-md-6 col-lg-3">
            <label asp-for="GiaTu" class="form-label"></label>
            <input asp-for="GiaTu" type="number" asp-format="{0:0}" class="form-control" min="0" step="1" aria-describedby="gia-loc" />
        </div>
        <div class="col-md-6 col-lg-3">
            <label asp-for="GiaDen" class="form-label"></label>
            <input asp-for="GiaDen" type="number" asp-format="{0:0}" class="form-control" min="0" step="1" aria-describedby="gia-loc" />
        </div>
        <div class="col-md-6 col-lg-4">
            <label asp-for="SapXep" class="form-label"></label>
            <select asp-for="SapXep" class="form-select">
                <option value="ten_tang">Tên sân A → Z</option>
                <option value="ten_giam">Tên sân Z → A</option>
                <option value="gia_tang">Giá tăng dần</option>
                <option value="gia_giam">Giá giảm dần</option>
                <option value="gio_tang">Giờ mở cửa tăng dần</option>
                <option value="gio_giam">Giờ mở cửa giảm dần</option>
            </select>
        </div>
        <div class="col-lg-2 d-flex flex-wrap align-items-end gap-2">
            <button type="submit" class="btn btn-outline-primary">Tìm / Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
        </div>
        <p id="gia-loc" class="form-text col-12 mb-0">Lọc và sắp xếp giá theo giá giờ thường T2–T6 (đồng/giờ). Nhập số nguyên, ví dụ 200000.</p>
    </form>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="h5 mb-0">Sân thể thao <span class="badge text-bg-primary">@Model.TongSoSan</span></h2>
        <div class="d-flex gap-2">
            @if (laQuanLy)
            {
                <a asp-action="Create" class="btn btn-primary btn-sm">Thêm sân</a>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">Về trang chủ</a>
        </div>
    </div>
    @if (!ViewData.ModelState.IsValid)
    {
        <p class="mb-0">Vui lòng sửa điều kiện tra cứu rồi bấm Tìm / Lọc.</p>
    }
    else if (Model.DanhSachSan.Count == 0)
    {
        <div class="ql-empty">
            <h2 class="h5">@(coDieuKien ? "Không có sân phù hợp" : "Chưa có sân để hiển thị")</h2>
            <p class="mb-0">@(coDieuKien ? "Thử thay đổi điều kiện tìm kiếm hoặc bấm Đặt lại." : "Danh sách sẽ xuất hiện khi có sân được cập nhật.")</p>
        </div>
    }
    else
    {
        <div class="table-responsive" role="region" aria-label="Bảng sân" tabindex="0">
            <table class="table table-hover align-middle ql-table">
                <caption>Trang @Model.TrangHienTai / @Model.TongSoTrang</caption>
                <thead><tr>
                    <th scope="col">Tên sân</th><th scope="col">Loại sân</th>
                    <th scope="col">Địa chỉ</th><th scope="col">Giá thuê (đồng/giờ)</th>
                    <th scope="col">Giờ phục vụ</th><th scope="col">Trạng thái</th>
                    <th scope="col">Thao tác</th>
                </tr></thead>
                <tbody>
                    @foreach (var san in Model.DanhSachSan)
                    {
                        var trangThai = san.TrangThai switch
                        {
                            TrangThaiSan.HoatDong => "Hoạt động",
                            TrangThaiSan.BaoTri => "Bảo trì",
                            _ => "Ngừng hoạt động"
                        };
                        var mau = san.TrangThai switch
                        {
                            TrangThaiSan.HoatDong => "text-bg-success",
                            TrangThaiSan.BaoTri => "text-bg-warning",
                            _ => "text-bg-secondary"
                        };
                        <tr>
                            <th scope="row">@san.TenSan</th>
                            <td>@san.TenLoai</td><td>@san.DiaChi</td>
                            <td class="text-nowrap">
                                <div>T2–T6 thường: @san.DonGia.ToString("N0", vanHoa) ₫</div>
                                <div>18h–21h: @((san.DonGiaCaoDiem ?? san.DonGia).ToString("N0", vanHoa)) ₫</div>
                                <div>T7, CN cả ngày: @((san.DonGiaCuoiTuan ?? san.DonGia).ToString("N0", vanHoa)) ₫</div>
                            </td>
                            <td class="text-nowrap">@san.GioMoCua.ToString("HH:mm") – @san.GioDongCua.ToString("HH:mm")</td>
                            <td><span class="badge @mau">@trangThai</span></td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@san.MaSan" class="btn btn-outline-primary btn-sm"
                                       asp-route-ngay="@(Model.NgaySuDung?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))"
                                       asp-route-batDau="@(Model.GioBatDau?.ToString("HH:mm", CultureInfo.InvariantCulture))"
                                       asp-route-ketThuc="@(Model.GioKetThuc?.ToString("HH:mm", CultureInfo.InvariantCulture))"
                                       aria-label="Chi tiết @san.TenSan">Xem</a>
                                    @if (laQuanLy)
                                    {
                                        <a asp-action="Edit" asp-route-id="@san.MaSan" class="btn btn-outline-secondary btn-sm"
                                           aria-label="Sửa @san.TenSan">Sửa</a>
                                        <a asp-action="Delete" asp-route-id="@san.MaSan" class="btn btn-outline-danger btn-sm"
                                           aria-label="Xóa @san.TenSan">Xóa</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TongSoTrang > 1)
        {
            <nav aria-label="Phân trang danh sách sân">
                <ul class="pagination flex-wrap">
                    @if (Model.TrangHienTai > 1)
                    {
                        <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="thamSoTrang" asp-route-trang="1">Đầu</a></li>
                        <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="thamSoTrang" asp-route-trang="@(Model.TrangHienTai - 1)">Trước</a></li>
                    }
                    @for (var trang = Math.Max(1, Model.TrangHienTai - 2); trang <= Math.Min(Model.TongSoTrang, Model.TrangHienTai + 2); trang++)
                    {
                        if (trang == Model.TrangHienTai)
                        {
                            <li class="page-item active"><span class="page-link" aria-current="page">@trang</span></li>
                        }
                        else
                        {
                            <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="thamSoTrang" asp-route-trang="@trang">@trang</a></li>
                        }
                    }
                    @if (Model.TrangHienTai < Model.TongSoTrang)
                    {
                        <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="thamSoTrang" asp-route-trang="@(Model.TrangHienTai + 1)">Sau</a></li>
                        <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="thamSoTrang" asp-route-trang="@Model.TongSoTrang">Cuối</a></li>
                    }
                </ul>
            </nav>
        }
    }
</section>
