@* Họ tên: Phan Giang Tâm; MSSV: 23103100196. Nội dung: Trang chi tiết sân. *@
@model QuanLyDatSan_UNETI5_DHTI17A4HN.ViewModels.SanTheThao.SanChiTietViewModel
@using QuanLyDatSan_UNETI5_DHTI17A4HN.Enums
@using System.Globalization
@using QuanLyDatSan_UNETI5_DHTI17A4HN.Services.Anh
@using QuanLyDatSan_UNETI5_DHTI17A4HN.ViewModels.Chung.Anh
@{
    ViewData["Title"] = "Chi tiết sân";
    var vanHoa = CultureInfo.GetCultureInfo("vi-VN");
    var daChonKhungGio = ViewData["GiaDuKien"] is decimal;
    var tienIch = Model.TienIch;
    if (string.IsNullOrWhiteSpace(tienIch))
    {
        tienIch = "Chưa cập nhật";
    }

    var ghiChu = Model.GhiChu;
    if (string.IsNullOrWhiteSpace(ghiChu))
    {
        ghiChu = "Không có";
    }

    var trangThai = Model.TrangThai switch
    {
        TrangThaiSan.HoatDong => "Hoạt động",
        TrangThaiSan.BaoTri => "Bảo trì",
        _ => "Ngừng hoạt động"
    };
}
<div class="ql-page-header">
    <h1>@Model.TenSan</h1>
    <p class="ql-subtitle">@Model.TenLoai · @trangThai</p>
</div>
<section class="ql-panel" aria-label="Thông tin sân">
    <partial name="_AnhDaiDien" model="@(new AnhDaiDienViewModel(NhomAnh.San, Model.MaSan, Model.TenSan, Model.DuongDanAnh is not null, ChiTiet: true, TaiCham: false))" />
    <h2 class="h5 mb-4">Thông tin sân</h2>
    <dl class="row">
        <dt class="col-sm-3">Loại sân</dt><dd class="col-sm-9">@Model.TenLoai</dd>
        <dt class="col-sm-3">Địa chỉ</dt><dd class="col-sm-9 text-break">@Model.DiaChi</dd>
        <dt class="col-sm-3">Tiện ích</dt>
        <dd class="col-sm-9 text-break">@tienIch</dd>
        <dt class="col-sm-3">Giá giờ thường T2–T6</dt><dd class="col-sm-9">@Model.DonGia.ToString("N0", vanHoa) ₫/giờ</dd>
        <dt class="col-sm-3">Cao điểm T2–T6 (18h–21h)</dt><dd class="col-sm-9">@((Model.DonGiaCaoDiem ?? Model.DonGia).ToString("N0", vanHoa)) ₫/giờ</dd>
        <dt class="col-sm-3">T7 và CN cả ngày</dt><dd class="col-sm-9">@((Model.DonGiaCuoiTuan ?? Model.DonGia).ToString("N0", vanHoa)) ₫/giờ</dd>
        <dt class="col-sm-3">Giờ phục vụ</dt>
        <dd class="col-sm-9">@Model.GioMoCua.ToString("HH:mm") – @Model.GioDongCua.ToString("HH:mm")</dd>
        <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@trangThai</dd>
        <dt class="col-sm-3">Ngày bảo trì</dt>
        <dd class="col-sm-9">@(Model.NgayBaoTri?.ToString("dd/MM/yyyy") ?? "Chưa có lịch")</dd>
        <dt class="col-sm-3">Ghi chú</dt>
        <dd class="col-sm-9 text-break">@ghiChu</dd>
    </dl>
    <h2 class="h5 mt-4">Tính thử tiền thuê</h2>
    <p class="form-text">Giá tham khảo theo khung giờ, chưa kiểm tra sân trống và chưa gồm dịch vụ.
        Đơn đặt hiện áp dụng giá giờ thường được lưu tại thời điểm đặt. Tiền trên đơn có thể khác kết quả tham khảo này.</p>
    <form asp-action="Details" method="get" class="row g-3 mb-4">
        <input type="hidden" name="id" value="@Model.MaSan" />
        @if (ViewData["LoiAnhSan"] is not true)
        {
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        }
        <div class="col-md-4">
            <label for="ngay" class="form-label">Ngày thuê</label>
            <input id="ngay" name="ngay" type="date" value="@ViewData["NgayTinhGia"]" class="form-control" required />
        </div>
        <div class="col-md-4">
            <label for="batDau" class="form-label">Giờ bắt đầu</label>
            <input id="batDau" name="batDau" type="time" value="@ViewData["GioBatDau"]" class="form-control" step="60" required />
        </div>
        <div class="col-md-4">
            <label for="ketThuc" class="form-label">Giờ kết thúc</label>
            <input id="ketThuc" name="ketThuc" type="time" value="@ViewData["GioKetThuc"]" class="form-control" step="60" required />
        </div>
        <div class="col-12"><button class="btn btn-outline-primary" type="submit">Tính tiền</button></div>
        @if (ViewData["GiaDuKien"] is decimal giaDuKien)
        {
            <div class="col-12"><div class="alert alert-info mb-0" role="status">Tiền thuê dự kiến: <strong>@giaDuKien.ToString("N0", vanHoa) ₫</strong></div></div>
        }
    </form>
    <p class="text-muted">Sân hoạt động có thể đã được đặt trong giờ bạn muốn sử dụng.</p>
    <a asp-action="Index" class="btn btn-outline-secondary"
       asp-route-ngaySuDung="@(daChonKhungGio ? ViewData["NgayTinhGia"] : null)"
       asp-route-gioBatDau="@(daChonKhungGio ? ViewData["GioBatDau"] : null)"
       asp-route-gioKetThuc="@(daChonKhungGio ? ViewData["GioKetThuc"] : null)">Về danh sách sân</a>
    @if (Model.TrangThai == TrangThaiSan.HoatDong
        && (User.Identity?.IsAuthenticated != true || User.IsInRole(nameof(VaiTro.KhachHang))))
    {
        <a asp-controller="DonDat" asp-action="Tao" asp-route-maSan="@Model.MaSan" class="btn btn-primary"
           asp-route-ngaySuDung="@(daChonKhungGio ? ViewData["NgayTinhGia"] : null)"
           asp-route-gioBatDau="@(daChonKhungGio ? ViewData["GioBatDau"] : null)"
           asp-route-gioKetThuc="@(daChonKhungGio ? ViewData["GioKetThuc"] : null)">Đặt sân</a>
        @if (User.Identity?.IsAuthenticated != true)
        {
            <p class="form-text mt-2">Đăng nhập tài khoản khách hàng để tiếp tục đặt sân.</p>
        }
    }
    @if (User.Identity?.IsAuthenticated == true && (User.IsInRole(nameof(VaiTro.Admin)) || User.IsInRole(nameof(VaiTro.NhanVien))))
    {
        <a asp-action="Edit" asp-route-id="@Model.MaSan" class="btn btn-outline-primary">Sửa sân</a>
        <a asp-action="Delete" asp-route-id="@Model.MaSan" class="btn btn-outline-danger">Xóa sân</a>
    }
</section>
@if (User.Identity?.IsAuthenticated == true && (User.IsInRole(nameof(VaiTro.Admin)) || User.IsInRole(nameof(VaiTro.NhanVien))))
{
    <section id="anh-dai-dien" class="ql-panel mt-4" aria-labelledby="tieu-de-anh-san">
        <h2 id="tieu-de-anh-san" class="h4">Ảnh đại diện sân</h2>
        <p class="form-text">Ảnh được lưu riêng với thông tin sân. Thay hoặc gỡ ảnh không thay đổi tên, giá hay giờ phục vụ.</p>
        <form asp-action="CapNhatAnh" asp-route-id="@Model.MaSan" method="post" enctype="multipart/form-data" asp-antiforgery="true">
            @if (ViewData["LoiAnhSan"] is true)
            {
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            }
            <input type="hidden" name="AnhCu" value="@Model.DuongDanAnh" />
            <div class="mb-3">
                <label for="tep-anh-san" class="form-label">Chọn ảnh sân mới</label>
                <input id="tep-anh-san" name="Tep" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" aria-describedby="quy-tac-anh-san" />
                <p id="quy-tac-anh-san" class="form-text">JPEG, PNG hoặc WebP tĩnh; tối đa 5 MiB, 4096 px mỗi chiều và 16 triệu điểm ảnh. Khi gỡ ảnh, để trống ô chọn tệp. Nếu có lỗi, vui lòng chọn lại file.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" name="ThaoTac" value="ThayAnh" class="btn btn-primary">Lưu ảnh sân</button>
                @if (Model.DuongDanAnh is not null)
                {
                    <button type="submit" name="ThaoTac" value="GoAnh" class="btn btn-outline-danger">Gỡ ảnh sân</button>
                }
            </div>
        </form>
    </section>
}
