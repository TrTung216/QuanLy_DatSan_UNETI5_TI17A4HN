@model QuanLyDatSan_UNETI5_DHTI17A4HN.ViewModels.DichVuSuaViewModel
@{ ViewData["Title"] = "Sửa dịch vụ"; }
<div class="ql-page-header">
    <h1>@ViewData["Title"]</h1>
    <p class="ql-subtitle">Cập nhật thông tin dịch vụ. Các trường có dấu * là bắt buộc.</p>
</div>
<section class="ql-panel" aria-label="Biểu mẫu sửa dịch vụ">
    <form asp-action="Sua" method="post" id="form-sua-dich-vu">
        <input type="hidden" asp-for="MaDichVu" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <partial name="_Form" model="Model" />
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a class="btn btn-outline-secondary" asp-action="DanhSach">Quay lại</a>
        </div>
    </form>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('form-sua-dich-vu').addEventListener('submit', function () {
            if ($(this).valid()) this.querySelector('button[type="submit"]').disabled = true;
        });
    </script>
}
