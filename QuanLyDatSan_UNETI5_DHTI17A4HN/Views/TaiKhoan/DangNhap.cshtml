@* M1: Trần Trọng Tùng; MSSV: 23103100202. Codex hỗ trợ giao diện đăng nhập. *@
@model QuanLyDatSan_UNETI5_DHTI17A4HN.ViewModels.DangNhapViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h1 class="h3 mb-3">Đăng nhập</h1>
        <form asp-action="DangNhap" method="post" id="dang-nhap">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="TenDangNhap" class="form-label"></label> <span aria-hidden="true">*</span>
                <input asp-for="TenDangNhap" class="form-control" autocomplete="username" maxlength="50" required />
                <span asp-validation-for="TenDangNhap" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MatKhau" class="form-label"></label> <span aria-hidden="true">*</span>
                <input asp-for="MatKhau" class="form-control" autocomplete="current-password" maxlength="128" required />
                <span asp-validation-for="MatKhau" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('dang-nhap').addEventListener('submit', function () {
            if ($(this).valid()) this.querySelector('button[type="submit"]').disabled = true;
        });
    </script>
}
