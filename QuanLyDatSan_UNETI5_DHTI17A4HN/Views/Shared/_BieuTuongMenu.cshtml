@* M1: Trần Trọng Tùng - 23103100202. Biểu tượng trang trí, không quyết định route hoặc quyền menu. *@
@model string
<svg class="ql-menu-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
