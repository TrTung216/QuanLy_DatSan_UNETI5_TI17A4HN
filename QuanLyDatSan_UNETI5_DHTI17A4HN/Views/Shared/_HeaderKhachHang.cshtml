@* M3: Nguyễn Văn Quý; MSSV: 23103100181. header và menu của giao diện khách hàng; menu đổi theo trạng thái đăng nhập. *@
@using QuanLyDatSan_UNETI5_DHTI17A4HN.Enums
@using QuanLyDatSan_UNETI5_DHTI17A4HN.Services
@inject ITaiKhoanHienTai TaiKhoanHienTai
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var daDangNhap = User.Identity?.IsAuthenticated == true;
    var laKhachHang = daDangNhap && User.IsInRole(nameof(VaiTro.KhachHang));
    // Chỉ thêm mục khi action và quyền phía server đã tồn tại; "CungNhomAction" giữ trạng thái đang chọn ở trang con.
    var menu = new List<MucMenu>();
    if (laKhachHang)
    {
        menu.Add(new MucMenu("Trang chủ", "KhachHang", "TrangChu"));
        menu.Add(new MucMenu("Đặt sân", "DonDat", "Tao"));
        menu.Add(new MucMenu("Lịch của tôi", "DonDat", "Index", ["ChiTiet"]));
        menu.Add(new MucMenu("Hồ sơ", "HoSo", "Index", ["Sua"]));
    }
    else
    {
        menu.Add(new MucMenu("Trang chủ", "Home", "Index"));
        menu.Add(new MucMenu("Đăng ký", "KhachHang", "DangKy"));
    }
    var trangDangNhap = string.Equals(controller, "TaiKhoan", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "DangNhap", StringComparison.OrdinalIgnoreCase);
}
<header class="ql-header">
    <nav class="navbar navbar-expand-lg navbar-light" aria-label="Điều hướng chính">
        <div class="container">
            <a class="navbar-brand ql-brand" asp-area="" asp-controller="@(laKhachHang ? "KhachHang" : "Home")" asp-action="@(laKhachHang ? "TrangChu" : "Index")">
                <span class="ql-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6">
                        <rect x="4" y="3" width="24" height="26" rx="3" />
                        <path d="M4 16h24M11 3v6h10V3M11 29v-6h10v6" />
                        <circle cx="16" cy="16" r="4" />
                    </svg>
                </span>
                <span>Quản lý đặt sân<small>Dành cho khách hàng</small></span>
            </a>
            <button class="navbar-toggler ql-menu-toggle" type="button" data-bs-toggle="collapse"
                    data-bs-target="#menu-chinh" aria-controls="menu-chinh" aria-expanded="false" aria-label="Mở hoặc thu gọn menu">
                <span class="navbar-toggler-icon" aria-hidden="true"></span>
                <span class="ql-menu-label">Menu</span>
            </button>
            <div class="collapse navbar-collapse" id="menu-chinh">
                <ul class="navbar-nav me-auto ql-nav">
                    @foreach (var muc in menu)
                    {
                        var hienTai = muc.KhopTrang(controller, action);
                        <li class="nav-item">
                            <a class="nav-link @(hienTai ? "active" : "")" aria-current="@(hienTai ? "page" : null)"
                               asp-area="" asp-controller="@muc.Controller" asp-action="@muc.Action">@muc.Ten</a>
                        </li>
                    }
                </ul>
                <div class="ql-account">
                    @if (daDangNhap)
                    {
                        <div class="ql-account-info">
                            <span class="ql-account-name">@TaiKhoanHienTai.HoTen</span>
                            <span class="ql-account-role">Khách hàng</span>
                        </div>
                        <form id="dang-xuat" asp-area="" asp-controller="TaiKhoan" asp-action="DangXuat" method="post" asp-antiforgery="true">
                            <button type="submit" class="btn btn-outline-primary">Đăng xuất</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-primary" asp-area="" asp-controller="TaiKhoan" asp-action="DangNhap"
                           aria-current="@(trangDangNhap ? "page" : null)">Đăng nhập</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>
