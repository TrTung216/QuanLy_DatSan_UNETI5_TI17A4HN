@* M1: Trần Trọng Tùng; MSSV: 23103100202. Codex hỗ trợ Việt hóa trang lỗi và giữ mã yêu cầu. *@
@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
}

<section class="ql-panel ql-details" aria-labelledby="tieu-de-loi">
    <h1 id="tieu-de-loi">Có lỗi xảy ra</h1>
    <p>Không thể xử lý yêu cầu lúc này. Vui lòng thử lại sau hoặc liên hệ người quản trị và cung cấp mã yêu cầu bên dưới nếu có.</p>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
</section>
