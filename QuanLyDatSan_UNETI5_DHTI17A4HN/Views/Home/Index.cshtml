@* M1: Trần Trọng Tùng; MSSV: 23103100202. Codex hỗ trợ trang chủ và liên kết theo trạng thái đăng nhập. *@
@{
    ViewData["Title"] = "Trang chủ";
}

<section class="ql-panel ql-welcome" aria-labelledby="tieu-de-trang-chu">
    <p class="ql-eyebrow">Hệ thống quản lý sân thể thao</p>
    <h1 id="tieu-de-trang-chu" class="mb-3">Chào mừng đến với Quản lý đặt sân</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <p class="ql-subtitle mb-4">Bạn đã đăng nhập. Xem thông tin tài khoản và sử dụng các chức năng được cấp quyền trên menu.</p>
        <a class="btn btn-primary" asp-controller="TaiKhoan" asp-action="ThongTin">Xem thông tin tài khoản</a>
    }
    else
    {
        <p class="ql-subtitle mb-4">Đăng nhập bằng tài khoản được cấp để truy cập hệ thống quản lý đặt sân.</p>
        <a class="btn btn-primary" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập vào hệ thống</a>
    }
</section>
