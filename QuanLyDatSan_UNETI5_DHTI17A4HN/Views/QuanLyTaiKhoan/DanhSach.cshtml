@* M1: Trần Trọng Tùng; MSSV: 23103100202. Codex hỗ trợ danh sách, tìm kiếm và phân trang tài khoản. *@
@model QuanLyDatSan_UNETI5_DHTI17A4HN.ViewModels.TaiKhoanDanhSachViewModel
@using QuanLyDatSan_UNETI5_DHTI17A4HN.Enums
@{
    ViewData["Title"] = "Quản lý tài khoản";
    string TenVaiTro(VaiTro vaiTro) => vaiTro switch
    {
        VaiTro.Admin => "Quản trị viên", VaiTro.NhanVien => "Nhân viên", VaiTro.KhachHang => "Khách hàng", _ => "Không xác định"
    };
}
<div class="ql-page-header d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="ql-subtitle">Quản lý thông tin, vai trò và trạng thái đăng nhập.</p>
    </div>
    <a class="btn btn-primary" asp-action="Tao">Thêm tài khoản</a>
</div>
<section class="ql-panel" aria-label="Danh sách tài khoản">
    <form asp-action="DanhSach" method="get" class="row g-3 mb-4">
        <div class="col-xl-4">
            <label asp-for="TuKhoa" class="form-label">Tìm kiếm</label>
            <input asp-for="TuKhoa" class="form-control" maxlength="100" placeholder="Tên đăng nhập, họ tên hoặc email" />
        </div>
        <div class="col-sm-6 col-xl-3">
            <label asp-for="VaiTro" class="form-label">Vai trò</label>
            <select asp-for="VaiTro" class="form-select">
                <option value="">Tất cả vai trò</option>
                <option value="1">Quản trị viên</option>
                <option value="2">Nhân viên</option>
                <option value="3">Khách hàng</option>
            </select>
        </div>
        <div class="col-sm-6 col-xl-3">
            <label asp-for="TrangThai" class="form-label">Trạng thái</label>
            <select asp-for="TrangThai" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="1">Hoạt động</option>
                <option value="0">Bị khóa</option>
            </select>
        </div>
        <div class="col-xl-2 d-flex flex-wrap align-items-end gap-2">
            <button type="submit" class="btn btn-outline-primary">Lọc</button>
            <a asp-action="DanhSach" class="btn btn-outline-secondary">Đặt lại</a>
        </div>
    </form>
    <p>@Model.TongSo tài khoản phù hợp</p>
    @if (Model.DanhSach.Count == 0)
    {
        <div class="ql-empty">
            <h2 class="h5">Chưa có kết quả</h2>
            <p class="mb-0">Thử thay đổi điều kiện tìm kiếm hoặc thêm tài khoản mới.</p>
        </div>
    }
    else
    {
        <div class="table-responsive" role="region" aria-label="Bảng tài khoản" tabindex="0">
            <table class="table table-hover align-middle ql-table ql-account-table">
                <caption>Tài khoản — trang @Model.Trang / @Model.TongTrang</caption>
                <thead><tr>
                    <th scope="col">Tên đăng nhập</th><th scope="col">Họ tên</th><th scope="col">Email</th>
                    <th scope="col">Vai trò</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th>
                </tr></thead>
                <tbody>
                @foreach (var taiKhoan in Model.DanhSach)
                {
                    var hoatDong = taiKhoan.TrangThai == TrangThaiTaiKhoan.HoatDong;
                    <tr>
                        <th scope="row">@taiKhoan.TenDangNhap</th>
                        <td>@taiKhoan.HoTen</td><td>@taiKhoan.Email</td><td>@TenVaiTro(taiKhoan.VaiTro)</td>
                        <td><span class="ql-status @(hoatDong ? "ql-status--completed" : "ql-status--cancelled")">@(hoatDong ? "Hoạt động" : "Bị khóa")</span></td>
                        <td><a class="btn btn-sm btn-outline-primary" asp-action="Sua" asp-route-id="@taiKhoan.MaTaiKhoan"
                               aria-label="Cập nhật tài khoản @taiKhoan.TenDangNhap">Cập nhật</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.TongTrang > 1)
        {
            <nav class="mt-3" aria-label="Phân trang tài khoản">
                <ul class="pagination ql-pagination">
                    @if (Model.Trang > 1)
                    {
                        <li class="page-item"><a class="page-link" asp-action="DanhSach" asp-route-trang="@(Model.Trang - 1)" asp-route-tuKhoa="@Model.TuKhoa" asp-route-vaiTro="@Model.VaiTro" asp-route-trangThai="@Model.TrangThai">Trước</a></li>
                    }
                    else { <li class="page-item disabled"><span class="page-link">Trước</span></li> }
                    @for (var i = Math.Max(1, Model.Trang - 2); i <= Math.Min(Model.TongTrang, Model.Trang + 2); i++)
                    {
                        if (i == Model.Trang)
                        {
                            <li class="page-item active"><span class="page-link" aria-current="page">@i</span></li>
                        }
                        else
                        {
                            <li class="page-item"><a class="page-link" asp-action="DanhSach" asp-route-trang="@i" asp-route-tuKhoa="@Model.TuKhoa" asp-route-vaiTro="@Model.VaiTro" asp-route-trangThai="@Model.TrangThai">@i</a></li>
                        }
                    }
                    @if (Model.Trang < Model.TongTrang)
                    {
                        <li class="page-item"><a class="page-link" asp-action="DanhSach" asp-route-trang="@(Model.Trang + 1)" asp-route-tuKhoa="@Model.TuKhoa" asp-route-vaiTro="@Model.VaiTro" asp-route-trangThai="@Model.TrangThai">Sau</a></li>
                    }
                    else { <li class="page-item disabled"><span class="page-link">Sau</span></li> }
                </ul>
            </nav>
        }
    }
</section>
