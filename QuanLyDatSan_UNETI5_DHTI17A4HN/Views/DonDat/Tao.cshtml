@* M3: Nguyễn Văn Quý; MSSV: 23103100181. giao diện khách hàng tạo đơn đặt sân. *@
@* M2: Phan Giang Tâm; MSSV: 23103100196. Làm rõ giá áp dụng và liên kết trở về sân đã chọn. *@
@model QuanLyDatSan_UNETI5_DHTI17A4HN.ViewModels.TaoDonViewModel
@using System.Globalization
@using QuanLyDatSan_UNETI5_DHTI17A4HN.Services
@{
    ViewData["Title"] = "Đặt sân";
    var inv = CultureInfo.InvariantCulture;
}
<div class="ql-form-page">
    <div class="ql-page-header">
        <p class="ql-eyebrow">Khách hàng</p>
        <h1>Đặt sân</h1>
        <p class="ql-subtitle">Đơn mới ở trạng thái "Chờ xác nhận" và giữ chỗ cho đến khi nhân viên xử lý.
            Đơn áp dụng giá giờ thường tại thời điểm đặt cho toàn bộ thời gian thuê. Các trường có dấu * là bắt buộc.</p>
    </div>
    <section class="ql-panel" aria-label="Biểu mẫu đặt sân">
        @if (Model.DanhSachSan.Count == 0)
        {
            <div class="ql-empty mb-3">Hiện chưa có sân nào nhận đặt.</div>
        }
        <form asp-action="Tao" method="post" id="dat-san">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="MaSan" class="form-label"></label> <span aria-hidden="true">*</span>
                <select asp-for="MaSan" class="form-select" required>
                    <option value="">-- Chọn sân --</option>
                    @foreach (var san in Model.DanhSachSan)
                    {
                        var nhan = $"{san.TenSan} - {san.TenLoai} - {HienThiDatSan.Tien(san.DonGia)}/giờ ({san.GioMoCua.ToString("HH:mm", inv)}-{san.GioDongCua.ToString("HH:mm", inv)})";
                        <option value="@san.MaSan" data-don-gia="@san.DonGia.ToString("0.##", inv)">@nhan</option>
                    }
                </select>
                <span asp-validation-for="MaSan" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NgaySuDung" class="form-label"></label> <span aria-hidden="true">*</span>
                <input type="date" id="NgaySuDung" name="NgaySuDung" class="form-control"
                       value="@(Model.NgaySuDung?.ToString("yyyy-MM-dd", inv))" required />
                <span asp-validation-for="NgaySuDung" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="GioBatDau" class="form-label"></label> <span aria-hidden="true">*</span>
                    <input type="time" id="GioBatDau" name="GioBatDau" class="form-control"
                           value="@(Model.GioBatDau?.ToString("HH:mm", inv))" required />
                    <span asp-validation-for="GioBatDau" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="GioKetThuc" class="form-label"></label> <span aria-hidden="true">*</span>
                    <input type="time" id="GioKetThuc" name="GioKetThuc" class="form-control"
                           value="@(Model.GioKetThuc?.ToString("HH:mm", inv))" required />
                    <span asp-validation-for="GioKetThuc" class="text-danger"></span>
                </div>
            </div>
            <p class="text-muted">Tiền sân dự kiến (tham khảo): <strong id="tien-du-kien">—</strong>. Hệ thống tính lại khi lưu đơn.</p>
            <p class="alert alert-info" role="status" id="khung-coc">Tiền đặt cọc tối thiểu (50% tiền sân, tham khảo): <strong id="coc-du-kien">—</strong>. Chọn sân, ngày và giờ để xem số tiền.</p>
            <button type="submit" class="btn btn-primary" disabled="@(Model.DanhSachSan.Count == 0)">Đặt sân</button>
            <a asp-action="Index" class="btn btn-link">Lịch của tôi</a>
            @if (Model.DanhSachSan.Any(san => san.MaSan == Model.MaSan))
            {
                <a asp-controller="SanTheThao" asp-action="Details" asp-route-id="@Model.MaSan" class="btn btn-link"
                   asp-route-ngay="@(Model.NgaySuDung?.ToString("yyyy-MM-dd", inv))"
                   asp-route-batDau="@(Model.GioBatDau?.ToString("HH:mm", inv))"
                   asp-route-ketThuc="@(Model.GioKetThuc?.ToString("HH:mm", inv))">Xem lại sân</a>
            }
        </form>
    </section>
</div>
<dialog id="hop-qr" class="ql-qr-dialog" aria-labelledby="tieu-de-qr">
    <h2 class="h5" id="tieu-de-qr">Đặt cọc bằng mã QR</h2>
    <p class="mb-2">Tiền đặt cọc tối thiểu: <strong id="coc-qr">—</strong> (50% tiền sân dự kiến)</p>
    <img src="~/images/qr-mo-phong.jpg" alt="Mã QR mô phỏng" class="ql-qr-anh" />
    <p class="text-muted small">Ảnh QR mô phỏng, không chuyển tiền thật. Bấm "Đã chuyển" để tạo đơn đặt sân; đơn chỉ được xác nhận sau khi nhân viên đối soát cọc.</p>
    <div class="d-flex gap-2 justify-content-end">
        <button type="button" id="nut-huy-qr" class="btn btn-outline-danger">Hủy</button>
        <button type="button" id="nut-da-chuyen" class="btn btn-primary">Đã chuyển</button>
    </div>
</dialog>
@section Styles {
    <style>
        .ql-qr-dialog { max-width: 420px; width: calc(100% - 2rem); border: 0; border-radius: .75rem; padding: 1.25rem; box-shadow: 0 10px 30px rgba(0, 0, 0, .25); }
        .ql-qr-dialog::backdrop { background: rgba(0, 0, 0, .5); }
        .ql-qr-anh { display: block; width: 100%; max-width: 280px; margin: .5rem auto; border: 1px solid #dee2e6; border-radius: .5rem; }
    </style>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var san = document.getElementById('MaSan');
            var batDau = document.getElementById('GioBatDau');
            var ketThuc = document.getElementById('GioKetThuc');
            var hienThi = document.getElementById('tien-du-kien');
            var hienThiCoc = document.getElementById('coc-du-kien');
            function phut(giaTri) {
                var phan = giaTri.split(':');
                return parseInt(phan[0], 10) * 60 + parseInt(phan[1], 10);
            }
            function capNhat() {
                var tuyChon = san.options[san.selectedIndex];
                var donGia;
                if (tuyChon) {
                    donGia = parseFloat(tuyChon.getAttribute('data-don-gia'));
                } else {
                    donGia = NaN;
                }
                if (isNaN(donGia) || !batDau.value || !ketThuc.value) { hienThi.textContent = '—'; hienThiCoc.textContent = '—'; return; }
                var soPhut = phut(ketThuc.value) - phut(batDau.value);
                if (soPhut <= 0) { hienThi.textContent = '—'; hienThiCoc.textContent = '—'; return; }
                var tienSan = Math.round(soPhut * donGia / 60);
                hienThi.textContent = new Intl.NumberFormat('vi-VN').format(tienSan) + ' ₫';
                hienThiCoc.textContent = new Intl.NumberFormat('vi-VN').format(Math.round(tienSan / 2)) + ' ₫';
            }
            [san, batDau, ketThuc].forEach(function (phanTu) { phanTu.addEventListener('change', capNhat); });
            capNhat();
            var form = document.getElementById('dat-san');
            var hopQr = document.getElementById('hop-qr');
            var cocQr = document.getElementById('coc-qr');
            var nutDaChuyen = document.getElementById('nut-da-chuyen');
            var nutHuy = document.getElementById('nut-huy-qr');
            // Bấm "Đặt sân": kiểm tra form rồi hiện QR; đơn chỉ được gửi lên server khi bấm "Đã chuyển".
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (window.jQuery && $.fn.valid && !$(form).valid()) return;
                if (hienThiCoc.textContent === '—') { form.submit(); return; } // giờ chưa hợp lệ: để server báo lỗi
                cocQr.textContent = hienThiCoc.textContent;
                hopQr.showModal();
            });
            nutDaChuyen.addEventListener('click', function () {
                nutDaChuyen.disabled = true;
                nutHuy.disabled = true;
                form.submit();
            });
            nutHuy.addEventListener('click', function () { hopQr.close(); });
        })();
    </script>
}
