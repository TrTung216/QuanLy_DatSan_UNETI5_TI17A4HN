@* M3: Nguyễn Văn Quý; MSSV: 23103100181. giao diện lịch đặt cá nhân của khách hàng. *@
@model QuanLyDatSan_UNETI5_DHTI17A4HN.ViewModels.DanhSachDonViewModel
@using QuanLyDatSan_UNETI5_DHTI17A4HN.Enums
@using QuanLyDatSan_UNETI5_DHTI17A4HN.Services
@{ ViewData["Title"] = "Lịch của tôi"; }
<div class="ql-page-header d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
        <p class="ql-eyebrow">Khách hàng</p>
        <h1>Lịch của tôi</h1>
        <p class="ql-subtitle">Các đơn đặt sân của bạn, mới nhất ở trên.</p>
    </div>
    <a asp-action="Tao" class="btn btn-primary">Đặt sân mới</a>
</div>
<section class="ql-panel" aria-label="Danh sách đơn đặt sân">
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label for="trangThai" class="visually-hidden">Trạng thái</label>
        <select id="trangThai" name="trangThai" class="form-select">
            <option value="">Tất cả trạng thái</option>
            @foreach (var t in Enum.GetValues<TrangThaiDatSan>())
            {
                <option value="@((int)t)" selected="@(Model.TrangThai == t)">@HienThiDatSan.TenTrangThai(t)</option>
            }
        </select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-secondary">Lọc</button></div>
</form>
@if (Model.Dong.Count == 0)
{
    <div class="ql-empty">
        <h2 class="h5">Chưa có đơn đặt sân</h2>
        <p class="mb-0">Chưa có đơn nào phù hợp với điều kiện lọc.</p>
    </div>
}
else
{
    <div class="table-responsive" role="region" aria-label="Danh sách đơn đặt sân" tabindex="0">
        <table class="table table-hover align-middle ql-table">
            <caption>Danh sách đơn đặt sân của bạn</caption>
            <thead>
                <tr><th scope="col">Mã đơn</th><th scope="col">Sân</th><th scope="col">Ngày</th><th scope="col">Giờ</th><th scope="col">Đơn giá</th><th scope="col">Trạng thái</th><th scope="col"><span class="visually-hidden">Thao tác</span></th></tr>
            </thead>
            <tbody>
                @foreach (var don in Model.Dong)
                {
                    <tr>
                        <td>@don.MaDatSan</td>
                        <td>@don.TenSan <span class="text-muted">(@don.TenLoai)</span></td>
                        <td>@don.GioBatDau.ToString("dd/MM/yyyy")</td>
                        <td>@don.GioBatDau.ToString("HH:mm") - @don.GioKetThuc.ToString("HH:mm")</td>
                        <td>@HienThiDatSan.Tien(don.DonGia)/giờ</td>
                        <td><span class="@HienThiDatSan.LopMau(don.TrangThai)">@HienThiDatSan.TenTrangThai(don.TrangThai)</span></td>
                        <td><a asp-action="ChiTiet" asp-route-id="@don.MaDatSan">Chi tiết</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted">Tổng cộng @Model.TongSo đơn.</p>
}
@if (Model.TongTrang > 1)
{
    <nav aria-label="Phân trang">
        <ul class="pagination ql-pagination">
            <li class="page-item @(Model.Trang <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-trangThai="@Model.TrangThai" asp-route-trang="@(Model.Trang - 1)">Trước</a>
            </li>
            @for (var i = 1; i <= Model.TongTrang; i++)
            {
                <li class="page-item @(i == Model.Trang ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-trangThai="@Model.TrangThai" asp-route-trang="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.Trang >= Model.TongTrang ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-trangThai="@Model.TrangThai" asp-route-trang="@(Model.Trang + 1)">Sau</a>
            </li>
        </ul>
    </nav>
}
</section>
