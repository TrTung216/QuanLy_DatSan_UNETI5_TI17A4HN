@* M4: Phạm Thành Nghĩa; MSSV: 23103100308. Codex hỗ trợ chi tiết đơn nhân viên (#22). *@
@model QuanLyDatSan_UNETI5_DHTI17A4HN.ViewModels.ChiTietDonQuanLyViewModel
@using QuanLyDatSan_UNETI5_DHTI17A4HN.Services
@{
    ViewData["Title"] = $"Chi tiết đơn #{Model.MaDatSan}";
    string ThoiDiem(DateTime? value) => value?.ToString("dd/MM/yyyy HH:mm") ?? "—";
}
<div class="ql-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div><h1>@ViewData["Title"]</h1>
        <span class="badge @HienThiDatSan.LopMau(Model.TrangThai)">@HienThiDatSan.TenTrangThai(Model.TrangThai)</span>
    </div>
    <a href="@Model.QuayLai" class="btn btn-outline-secondary">Quay lại danh sách</a>
</div>
<div class="row g-4">
    <section class="col-lg-6" aria-label="Khách hàng và sân">
        <div class="ql-panel h-100">
            <h2 class="h5">Khách hàng</h2>
            <dl class="row">
                <dt class="col-sm-4">Mã khách</dt><dd class="col-sm-8">#@Model.MaKhachHang</dd>
                <dt class="col-sm-4">Họ tên</dt><dd class="col-sm-8">@Model.TenKhachHang</dd>
                <dt class="col-sm-4">Điện thoại</dt><dd class="col-sm-8">@Model.SoDienThoai</dd>
                <dt class="col-sm-4">Email</dt><dd class="col-sm-8 text-break">@Model.Email</dd>
            </dl>
            <h2 class="h5">Thông tin sử dụng sân</h2>
            <dl class="row">
                <dt class="col-sm-4">Sân / loại sân</dt><dd class="col-sm-8">@Model.TenSan / @Model.TenLoai</dd>
                <dt class="col-sm-4">Địa chỉ</dt><dd class="col-sm-8">@Model.DiaChi</dd>
                <dt class="col-sm-4">Bắt đầu</dt><dd class="col-sm-8">@ThoiDiem(Model.GioBatDau)</dd>
                <dt class="col-sm-4">Kết thúc</dt><dd class="col-sm-8">@ThoiDiem(Model.GioKetThuc)</dd>
                <dt class="col-sm-4">Đơn giá trên đơn</dt><dd class="col-sm-8">@HienThiDatSan.Tien(Model.DonGia)/giờ</dd>
            </dl>
        </div>
    </section>
    <section class="col-lg-6" aria-label="Tiền và các mốc xử lý">
        <div class="ql-panel h-100">
            <h2 class="h5">Thông tin tiền</h2>
            <dl class="row">
                <dt class="col-sm-5">Tiền cọc đã ghi nhận</dt><dd class="col-sm-7">@HienThiDatSan.Tien(Model.TienCoc)</dd>
                @if (Model.TongTien.HasValue)
                {
                    <dt class="col-sm-5">Tiền sân đã chốt</dt><dd class="col-sm-7">@HienThiDatSan.Tien(Model.TienSan ?? 0m)</dd>
                    <dt class="col-sm-5">Tiền dịch vụ đã chốt</dt><dd class="col-sm-7">@HienThiDatSan.Tien(Model.TienDichVu ?? 0m)</dd>
                    <dt class="col-sm-5">Tổng tiền đã chốt</dt><dd class="col-sm-7"><strong>@HienThiDatSan.Tien(Model.TongTien.Value)</strong></dd>
                }
                else
                {
                    <dt class="col-sm-5">Tiền sân dự kiến</dt><dd class="col-sm-7">@HienThiDatSan.Tien(Model.TienSanDuKien)</dd>
                    <dt class="col-sm-5">Tổng tiền</dt><dd class="col-sm-7">Chưa chốt</dd>
                }
            </dl>
            <h2 class="h5">Các mốc xử lý</h2>
            <dl class="row">
                <dt class="col-sm-5">Ngày tạo đơn</dt><dd class="col-sm-7">@ThoiDiem(Model.NgayDat)</dd>
                <dt class="col-sm-5">Xác nhận</dt><dd class="col-sm-7">@ThoiDiem(Model.NgayXacNhan)</dd>
                <dt class="col-sm-5">Hủy / từ chối</dt><dd class="col-sm-7">@ThoiDiem(Model.NgayHuy)</dd>
                <dt class="col-sm-5">Hoàn thành</dt><dd class="col-sm-7">@ThoiDiem(Model.NgayHoanThanh)</dd>
                @if (!string.IsNullOrWhiteSpace(Model.LyDoHuy))
                {
                    <dt class="col-sm-5">Lý do hủy / từ chối</dt><dd class="col-sm-7 text-break" style="white-space: pre-wrap">@Model.LyDoHuy</dd>
                }
            </dl>
        </div>
    </section>
</div>
